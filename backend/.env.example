# Wikipedia Knowledge Explorer — backend environment variables.
# Copy to `.env` and adjust per environment. All names are case-insensitive.

# REQUIRED. Wikipedia REST API endpoint.
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php

# Allowed CORS origins (comma-separated). Default: empty list (fail-closed).
# Example for local dev: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# --- Phase-3 summarizer service ----------------------------------------------
# All unset by default → behaviour matches today (TFIDFSummarizer fallback).

# Base URL of the wke-summarizer inference service.
# Example in cluster: http://wke-summarizer.wke.svc.cluster.local:8000
# SUMMARIZER_URL=

# Per-request timeout (seconds) to the summarizer service. Default: 30.0
# SUMMARIZER_TIMEOUT_SECONDS=30.0

# Semaphore size for fan-out to the summarizer service. Default: 8
# SUMMARIZER_MAX_CONCURRENCY=8

# Redis cache URL for summary results. If unset → cache is skipped.
# Example: redis://wke-redis.wke.svc.cluster.local:6379/0
# REDIS_URL=

# HuggingFace model used by the summarizer service. Default: sshleifer/distilbart-cnn-6-6
# SUMMARIZER_MODEL=sshleifer/distilbart-cnn-6-6

# HuggingFace model revision (commit SHA). REQUIRED when SUMMARIZER_URL is set.
# Pin to a specific SHA for supply-chain integrity.
# Example: SUMMARIZER_MODEL_REVISION=8f6e4f5...
# SUMMARIZER_MODEL_REVISION=

# Redis TTL for cached summaries (seconds). Default: 2592000 (30 days).
# SUMMARIZER_CACHE_TTL_SECONDS=2592000
